<odoo>
  <data>
    <!-- COURSE -->
    <record model="ir.ui.view" id="course_form">
      <field name="name">Course form</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="title"/>
            </group>
            <notebook>
              <page string="Descriptions">
                <group>
                  <field name="description" string="Description"/>
                  <field name="sessions" dsadsstring="Sessions"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    
    <record model="ir.ui.view" id="course_list">
      <field name="name">Course list</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <list>
          <field name="title"/>
          <field name="description"/>
        </list>
      </field>
    </record>

    <record id="course_search" model="ir.ui.view">
      <field name="name">open_academy.course.search</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <search>
            <field name="title"/>
        </search>
      </field>
    </record>

    <record model="ir.actions.act_window" id="course_action">
      <field name="name">Course window</field>
      <field name="res_model">open_academy.course</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- SESSION -->
    <record model="ir.ui.view" id="session_form">
      <field name="name">Session form</field>
      <field name="model">open_academy.session</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="start_date"/>
              <field name="duration"/>
              <field name="seats"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    
    <record model="ir.ui.view" id="session_list">
      <field name="name">Session list</field>
      <field name="model">open_academy.session</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="start_date"/>
          <field name="duration"/>
          <field name="seats"/>
        </list>
      </field>
    </record>

    <record model="ir.actions.act_window" id="session_action">
      <field name="name">Session window</field>
      <field name="res_model">open_academy.session</field>
      <field name="view_mode">list,form</field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Open Academy" id="open_academy_menu_root"/>
    <!-- actions -->
    <menuitem name="Course" id="open_academy_course_menu" parent="open_academy_menu_root" action="course_action"/>
    <menuitem name="Session" id="open_academy_session_menu" parent="open_academy_menu_root" action="session_action"/>
  </data>
</odoo>
