<odoo>
  <data>
    <!-- COURSE -->
    <record model="ir.ui.view" id="course_form">
      <field name="name">Course form</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="title"/>
            </group>
            <notebook>
              <page string="Descriptions">
                <group>
                  <field name="description" string="Description"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    
    <record model="ir.ui.view" id="course_list">
      <field name="name">Course list</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <list>
          <field name="title"/>
          <field name="description"/>
        </list>
      </field>
    </record>

    <record id="course_search" model="ir.ui.view">
      <field name="name">open_academy.course.search</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <search>
            <field name="title"/>
        </search>
      </field>
    </record>

    <record model="ir.actions.act_window" id="course_action">
      <field name="name">Course window</field>
      <field name="res_model">open_academy.course</field>
      <field name="view_mode">list,form</field>
    </record>


    <!-- Top menu item -->
    <menuitem name="Open Academy" id="open_academy_menu_root"/>
    <!-- actions -->
    <menuitem name="Course" id="open_academy_course_menu" parent="open_academy_menu_root" action="course_action"/>
  </data>
</odoo>
