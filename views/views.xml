<odoo>
  <data>
    <!-- COURSE -->
    <record model="ir.ui.view" id="course_form">
      <field name="name">Course form</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="title"/>
            </group>
            <notebook>
              <page string="Descriptions">
                <group>
                  <field name="description" string="Description"/>
                  <field name="sessions" dsadsstring="Sessions"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    
    <record model="ir.ui.view" id="course_list">
      <field name="name">Course list</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <list>
          <field name="title"/>
          <field name="description"/>
          <field name="sessions"/>
        </list>
      </field>
    </record>

    <record id="course_search" model="ir.ui.view">
      <field name="name">open_academy.course.search</field>
      <field name="model">open_academy.course</field>
      <field name="arch" type="xml">
        <search>
            <filter
              name="my_courses"
              string="My Courses"
              domain="[('responsible_user', '=', uid)]"
            />
            <filter
              name="group_by_responsible_user"
              string="Group by responsible user"
              context="{'group_by': 'responsible_user'}"
            />
        </search>
      </field>
    </record>

    <record model="ir.actions.act_window" id="course_action">
      <field name="name">Course window</field>
      <field name="res_model">open_academy.course</field>
      <field name="view_mode">list,form</field>
      <field name="context">{'search_default_my_courses': 1}</field>
    </record>

    <!-- SESSION -->
    <record model="ir.ui.view" id="session_form">
      <field name="name">Session form</field>
      <field name="model">open_academy.session</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="start_date"/>
              <field name="duration"/>
              <field name="seats"/>
              <field name="attendees"/>
              <field name="taken_seats_percent" widget="progressbar" options="{'color':'success'}"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    
    <record model="ir.ui.view" id="session_list">
      <field name="name">Session list</field>
      <field name="model">open_academy.session</field>
      <field name="arch" type="xml">
        <list decoration-info="duration &lt; 5" decoration-danger="duration &gt;= 15">
          <field name="name"/>
          <field name="start_date"/>
          <field name="duration"/>
          <field name="seats"/>
          <field name="attendees"/>
          <field name="taken_seats_percent" widget="progressbar"/>
        </list>
      </field>
    </record>

    <record model="ir.ui.view" id="session_calendar">
      <field name="name">Session Calendar</field>
      <field name="model">open_academy.session</field>
      <field name="arch" type="xml">
        <calendar date_start="start_date">
          <field name="name"></field>
        </calendar>
      </field>
    </record>

    <record model="ir.ui.view" id="session_kanban">
      <field name="name">Session Kanban</field>
      <field name="model">open_academy.session</field>
      <field name="arch" type="xml">
        <kanban>
          <field name="name"/>
          <field name="start_date"/>
          <field name="duration"/>
          <field name="seats"/>
          <field name="attendees_count"/>
          <templates>
                <t t-name="card">
                    <div class="o_kanban_card">
                        <strong>
                            <field name="name"/>
                        </strong>

                        <div>
                            <field name="start_date"/>
                        </div>

                        <div>
                            Duration: <field name="duration"/>
                        </div>

                        <div>
                            Seats: <field name="seats"/>
                        </div>

                        <div>
                            Attendees: <field name="attendees_count"/>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
      </field>
    </record>

    <record model="ir.ui.view" id="session_graph">
      <field name="name">Session Graph</field>
      <field name="model">open_academy.session</field>
      <field name="arch" type="xml">
        <graph string="Number of attendees">
          <field name="course_id"/>
          <field name="attendees_count" type="measure"/>
        </graph>
      </field>
    </record>

    <record model="ir.actions.act_window" id="session_action">
      <field name="name">Session window</field>
      <field name="res_model">open_academy.session</field>
      <field name="view_mode">list,form,calendar,graph,kanban</field>
    </record>

    

    <!-- PARTNER -->
    <record id="partner_form_open_academy" model="ir.ui.view">
      <field name="name">Partner form inherit</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>

      <field name="arch" type="xml">
        <xpath expr="//field[@name='name']" position="after">
          <group string="Partner Info">
            <field name="instructor"/>
            <field name="sessions"/>
          </group>
        </xpath>
      </field>
    </record>

    <!-- Top menu item -->
    <menuitem name="Open Academy" id="open_academy_menu_root"/>
    <!-- actions -->
    <menuitem name="Course" id="open_academy_course_menu" parent="open_academy_menu_root" action="course_action"/>
    <menuitem name="Session" id="open_academy_session_menu" parent="open_academy_menu_root" action="session_action"/>
  </data>
</odoo>
