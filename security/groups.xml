<odoo>
    <record id="group_open_academy_manager" model="res.groups">
        <field name="name">Open Academy Manager</field>
    </record>

    <record id="delete_cancelled_only" model="ir.rule">
        <field name="name">Only the responsible for a course may write and unlink</field>
        <field name="model_id" ref="open_academy.model_open_academy_course"/>
        <field name="groups" eval="[(4, ref('open_academy.group_open_academy_manager'))]"/>
        <field name="domain_force">
            ['|', ('responsible_user', '=', user.id), ('responsible_user', '=', False)]
        </field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>